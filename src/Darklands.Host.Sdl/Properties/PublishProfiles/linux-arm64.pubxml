<Project>
  <!-- A player's release for Linux aarch64: one self-contained, compressed program with the aarch64 libSDL3.so.0 beside it
       (a native library the program loads from its own folder first; deleting it makes the program use the system's).
       The SDL3 is SDL 3.4.20 built from the official source release on an aarch64 machine (Native/linux-arm64,
       tools/linux/build_sdl3.sh), so the game also runs where the system has no SDL3 (Debian 12).
       NOTE: Mt32emu.net 1.0.0-rc.1 ships no linux-arm64 native library, so the Roland MT-32/CM-32L MIDI driver falls back to
       the Sound Blaster Pro FM music (Mt32Synth catches DllNotFoundException). Everything else works.
       dotnet publish src/Darklands.Host.Sdl -p:PublishProfile=linux-arm64
       Publish on Linux (or pack with tar) so DarklandsRP keeps its executable bit; a zip made on Windows loses it (chmod +x DarklandsRP). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <!-- never the developer's inspector in a player's release -->
    <DevTools>false</DevTools>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- no .pdb files of the referenced projects beside the program -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <!-- forward slashes: MSBuild normalises them on Windows too, so this profile works from either OS -->
    <PublishDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'artifacts', 'linux-arm64'))/</PublishDir>
  </PropertyGroup>
</Project>
