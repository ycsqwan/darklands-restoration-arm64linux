<Project>
  <!-- The Workshop (the translators' editor) in a player's release for linux-arm64: a download of its own whose root is the
       Workshop folder (unzipped into the game's folder: DarklandsRP/Workshop, which finds DarklandsRP one folder up): one
       self-contained, compressed program with Avalonia's native libraries inside.
       dotnet publish src/Darklands.Workshop -p:PublishProfile=linux-arm64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'artifacts', 'workshop-linux-arm64', 'Workshop'))/</PublishDir>
  </PropertyGroup>
</Project>
